{{define "breadcrumb-items"}}{{end}}
{{define "brand"}}Ingestor{{end}}
{{define "title"}}Base{{end}}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ template "title" . }} | {{ template "brand" . }}</title>
        <link href="{{ (printf "%s/%s" .StaticLibsSubDir "css/bootstrap.min.css") | staticPathWithHash  }}" rel="stylesheet">
    </head>
    <body class="d-flex flex-column min-vh-100">
        {{template "navbar" .}}

        <main class="container mt-4 flex-grow-1">
            {{template "main" .}}
        </main>

        {{template "footer" .}}

        <script src="{{ (printf "%s/%s" .StaticLibsSubDir "js/bootstrap.bundle.min.js") | staticPathWithHash }}"></script>
    </body>
</html>
